# ==============================================================================
# Vaidyaarc Backend Environment Configuration (Template)
# Copy this file to .env and fill in the values for local development.
# Never commit real credentials to Git.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Database (MongoDB / DocumentDB)
MONGODB_URI=mongodb://localhost:27017/vaidyaarc

# Storage & Cloud (AWS S3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET=your_s3_bucket_name_here

# AI & LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Speech-to-Text (STT) Service
STT_API_URL=http://localhost:5001

# AI Agent Service (Optional / Internal)
VAIDYAARC_AGENT_URL=http://localhost:3000/api/v1/agent/explain
VAIDYAARC_AGENT_API_KEY=your_agent_api_key_here

# Indian Healthcare Ecosystem (ABDM / Ayushman Bharat Digital Mission)
ABDM_CLIENT_ID=your_abdm_client_id_here
ABDM_CLIENT_SECRET=your_abdm_client_secret_here
ABDM_BASE_URL=https://dev.abdm.gov.in

# SMS & Communication Provider (Twilio / Fast2SMS)
SMS_PROVIDER_API_KEY=your_sms_provider_api_key_here
SMS_SENDER_ID=your_sms_sender_id_here

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
